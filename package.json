{
  "name": "pi-clock-display",
  "version": "1.0.0",
  "description": "Fullscreen Raspberry Pi kiosk clock with local admin configuration.",
  "type": "module",
  "main": "src/server/index.js",
  "scripts": {
    "start": "node src/server/index.js",
    "dev": "node --watch src/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node --check src/server/index.js && node --check src/server/configStore.js && node --check src/server/weather.js && node --check src/server/photos.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "luxon": "^3.5.0",
    "mime-types": "^2.1.35",
    "sanitize-html": "^2.14.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
